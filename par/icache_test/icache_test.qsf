# -------------------------------------------------------------------------- #
# DE2Extra — ICACHE test Quartus Settings File                                #
# Target: DE2-115 (EP4CE115F29C7)                                            #
# Minimal: CPU + SDRAM + VGA only, ICACHE enabled with burst                 #
# -------------------------------------------------------------------------- #

# === Device Configuration ===
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY icache_test_top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# === Source Files ===

# Our RTL — minimal set
set_global_assignment -name VHDL_FILE ../../src/rtl/lib/de2extra_pkg.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/lib/build_info_pkg.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/glue/clk_rst_gen.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/neorv32_wrapper.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/sdram_ctrl.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/async_fifo.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/bus/wb_intercon_icache.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/font_rom_pkg.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/vga_text_terminal.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/vga_timing_640x480.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/fb_reader_rgb565.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/periph/vga_pixel_ctrl.vhd
set_global_assignment -name VHDL_FILE ../../src/rtl/icache_test_top.vhd

# IP cores
set_global_assignment -name VHDL_FILE ../../src/ip/altpll_50_100.vhd

# NEORV32 CPU (submodule) — all core VHDL files
set_global_assignment -name VHDL_FILE ../../neorv32/rtl/core/neorv32_package.vhd
set_global_assignment -name VHDL_FILE ../../neorv32/rtl/core/neorv32_prim.vhd
set_global_assignment -name VHDL_FILE ../../neorv32/rtl/core/neorv32_bootrom_image.vhd
